#!/bin/sh
# Link went away: stop the player and put something on screen, rather than
# leaving the last decoded frame frozen there.
if [ -f /tmp/fpv.pid ]; then
    kill "$(cat /tmp/fpv.pid)" 2>/dev/null
    rm -f /tmp/fpv.pid
fi
rm -f /tmp/fpv.url
killall mi-player mi-player-alkaid 2>/dev/null
echo "fpv: link down, player stopped" > /dev/console

# The player held /dev/mi_hdmi open, so the transmitter stopped when it did and
# the splash below would be drawn to a dead output. Callers that are about to
# start their own player skip this, since it would only be torn down again.
[ "$FPV_KEEP_DISPLAY_DOWN" = 1 ] || display-up

# Backgrounded and holding /dev/fb0: the driver drops the window's contents when
# the last user closes it, so a splash that exits leaves the bare video plane
# showing -- which is solid red once a player has run.
[ -x /bin/fb-splash ] && [ -e /dev/fb0 ] && \
    (setsid fb-splash -p --hold "OpenIPC Ground Station" \
                            "Link lost" \
                            "Waiting for air unit" >/dev/null 2>&1 &)
exit 0
