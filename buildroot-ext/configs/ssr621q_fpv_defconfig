# SigmaStar SSR621Q / Infinity2M ground station.
#
# Builds a complete ground station: the vendor 4.9.84 kernel, the MI multimedia
# blobs, the 8812AU driver, wfb-ng, and the tools in src/. Everything is built
# from source except the MI blobs, which have none.
#
# Verified on hardware receiving H.265 from the air unit with zero lost packets.

# ── Architecture ─────────────────────────────────────────────────────────────
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_INSTRUCTIONS_ARM=y
# The toolchain is built --with-fpu=vfpv3-d16, not the neon-vfpv4 a Cortex-A7
# would normally imply. Declaring anything else fails buildroot's ABI check.
BR2_ARM_FPU_VFPV3D16=y
BR2_ARM_EABIHF=y

# ── Toolchain ────────────────────────────────────────────────────────────────
# Deliberately the same Bootlin 2018.11 toolchain the vendor SDK is built with:
# gcc 7.3.0, glibc 2.27, 4.1 kernel headers. The MI blobs are prebuilt against
# that glibc, and gcc 7.3 is the compiler this vendor kernel is known to build
# with, so reusing it keeps the port from changing two things at once.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_SSR621Q_FPV_PATH)/../build/toolchain/armv7-eabihf--glibc--stable-2018.11-1"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-buildroot-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_GCC_7=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_1=y
# The selectable symbol is the CUSTOM_ one; BR2_TOOLCHAIN_EXTERNAL_GLIBC is what
# it selects. Setting the latter directly is silently ignored and the choice
# falls back to uClibc, which the prebuilt MI blobs will not load against.
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP_STRONG=y

# ── System ───────────────────────────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="nvr-gs"
BR2_TARGET_GENERIC_ISSUE="SSR621Q ground station"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# The OpenIPC-style well-known password, same as the air unit,
# so the board is usable out of the box. Documented rather than hidden: anyone
# with the image can read the hash, so treat the wired side as trusted-LAN-only.
# Without this dropbear refuses every login, because it rejects empty passwords.
BR2_TARGET_GENERIC_ROOT_PASSWD="12345678"
BR2_TARGET_GENERIC_PASSWD_SHA512=y
# Networking comes from the overlay's /etc/network/interfaces, not from
# BR2_SYSTEM_DHCP, so there is one source of truth for it.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SSR621Q_FPV_PATH)/board/ssr621q/rootfs-overlay"

# Written by build-buildroot.sh; carries LINUX_OVERRIDE_SRCDIR.
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_SSR621Q_FPV_PATH)/../build/local.mk"

# ── Filesystem ───────────────────────────────────────────────────────────────
# The board boots a kernel with the rootfs built in, so the cpio goes into the
# image rather than being flashed separately. Compression comes from the
# CONFIG_RD_XZ in linux.fragment.
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

# ── Packages ─────────────────────────────────────────────────────────────────
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SSR621Q_FPV_PATH)/board/ssr621q/busybox.fragment"

# curl, purely so sysupgrade can follow a GitHub release redirect. BusyBox wget
# stalls forever moving between two https hosts, which every release download
# does. mbedTLS rather than OpenSSL: a few hundred KB against a megabyte and a
# half, and there is 2.1M spare in the system partition.
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y

# libpng, so the OSD can load a Betaflight/INAV font atlas at runtime the way
# msposd does -- the same font packs, dropped in without rebuilding. Pulls zlib.
BR2_PACKAGE_LIBPNG=y
# Only http and https are wanted. These three are on by default and pull in
# proxies, a cookie store, and LDAP/RTSP/SMB, none of which fetches a firmware
# image.
# BR2_PACKAGE_LIBCURL_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_SIGMASTAR_MI=y
BR2_PACKAGE_GS_TOOLS=y
BR2_PACKAGE_RTL8812AU=y
BR2_PACKAGE_WFB_NG=y
# apfpv mode, the default, joins the air unit's AP. wpa_supplicant needs both
# drivers: apfpv tries nl80211 and falls back to wext, because the RTL fork
# does not always bring up a working cfg80211 path. iw is what it uses to read
# the interface mode, the signal and the scan results.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_IW=y
# So a board running this image can write the stock firmware back to mtd2
# itself, instead of the only way out being U-Boot over serial.
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_FLASHCP=y
BR2_PACKAGE_MTD_FLASH_ERASE=y

# ── Kernel ───────────────────────────────────────────────────────────────────
# The source is the vendor SDK tree, supplied via LINUX_OVERRIDE_SRCDIR in
# buildroot's local.mk (written by build-buildroot.sh) so nothing is fetched.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="4.9.84"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="infinity2m_ssc010a_s01a"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SSR621Q_FPV_PATH)/board/ssr621q/linux.fragment"
# Ask for zImage, not uImage. SigmaStar's rule hangs off the zImage recipe and
# produces arch/arm/boot/uImage as a by-product, wrapping the raw Image with the
# bundled scripts/mkimage and appending the built-in DTB. Asking for uImage
# instead runs the stock rule, which wraps zImage and wants a LOADADDR.
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="zImage"
BR2_LINUX_KERNEL_IMAGE_NAME="uImage"

# Fails the build on an oversized or malformed image, rather than at the flash
# prompt with the partition already erased. Signs too when a local key exists.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SSR621Q_FPV_PATH)/board/ssr621q/post-image.sh"
