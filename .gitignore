# ── Build trees and outputs ──────────────────────────────────────────────────
# build/ holds everything fetched or unpacked: the SigmaStar SDK, toolchains,
# buildroot, the RTL8812AU driver and the vendor firmware dumps.
# All of it is reproducible from fetch-deps.sh, and it runs to several GB.
build/
output/
logs/

# ── Legacy linux-chenxing 6.5 track ──────────────────────────────────────────
linux-chenxing/
busybox-1.36.1/
busybox-1.36.1.tar.bz2
dropbear-2022.83/
dropbear-2022.83.tar.bz2
initramfs.cpio
romfs-new/
romfs/
rootfs/
squashfs-root/
uImage-chenxing

# ── Firmware blobs ───────────────────────────────────────────────────────────
# Covers NBD80S10S-KL_original.bin, the 16MB stock flash dump. Keep a copy
# OUTSIDE the repo: it is the only route back to stock, and the only recovery
# from a bad write below 0x50000 short of a SPI programmer.
*.bin
*.sqfs
*.img
current_state.bin

# ...but the vendored /config tables are .bin too, and the image needs them:
# config/vdec_fw/chagall.bin is the video decoder firmware. Without this the
# rule above quietly leaves them out of a clone and CI builds an image that
# cannot decode video.
!vendor/**/*.bin

# ── Local scratch ────────────────────────────────────────────────────────────
.venv/
screenlog*
*.log

# Points fetch-deps.sh at the private repo holding the stock flash dump. Local
# to each checkout, and often a URL with a username in it, so it stays out.
.vendor-repo

# Keeps the generated fallback MAC stable across rebuilds. Per-checkout, so
# two people building this never collide on the same address.
.fallback-mac

# Signing keys. Only signing-key.pub (the raw 32-byte public half) belongs in
# the repo; the private key lives outside it and in the CI secret.
*.key
*.pem
signing.key
